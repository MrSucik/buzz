{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "extends": ["@mrsucik/biome-config"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noUnknownAtRules": "off",
        "noExplicitAny": "on",
        "noAsyncPromiseExecutor": "on"
      },
      "a11y": {
        "useFocusableInteractive": "on",
        "useAriaPropsForRole": "on",
        "noSvgWithoutTitle": "on",
        "useSemanticElements": "on",
        "noLabelWithoutControl": "on",
        "noStaticElementInteractions": "on",
        "noAutofocus": "on"
      },
      "style": {
        "noNonNullAssertion": "on"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
